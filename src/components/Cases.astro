---
import { experiences } from "../data/experiences";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const cases = t("cases");
const basePath = lang === "pt" ? "/trajetoria" : "/en/career";
---

<section id="cases" class="scroll-mt-24 border-t border-line px-6 py-20 md:px-12 md:py-32">
  <div class="mb-14 flex items-end justify-between md:mb-20" data-reveal>
    <h2 class="font-display text-4xl text-ink md:text-6xl">{cases.heading}</h2>
    <span class="hidden text-sm uppercase tracking-widest text-muted md:block">
      {cases.range}
    </span>
  </div>

  <div class="border-t border-line">
    {
      experiences.map((exp) => {
        const text = exp[lang];
        return (
          <div
            class="group -mx-2 grid grid-cols-1 gap-3 border-b border-line px-2 py-8 transition-colors duration-500 hover:bg-void-soft/60 md:-mx-4 md:grid-cols-12 md:gap-6 md:px-4 md:py-10"
            data-reveal
          >
            <div class="flex items-center gap-3 md:col-span-3">
              <span class="text-sm uppercase tracking-wider text-muted">
                {text.period}
              </span>
              {exp.current && (
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              )}
            </div>
            <div class="flex items-start gap-3 md:col-span-4">
              {exp.logo && (
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-line bg-void-soft p-1.5 md:h-12 md:w-12">
                  <img
                    src={exp.logo}
                    alt={`Logo ${text.org}`}
                    class="h-full w-full object-contain"
                    loading="lazy"
                  />
                </div>
              )}
              <div>
                <h3 class="font-display text-xl text-ink transition-colors duration-300 group-hover:text-accent md:text-2xl">
                  {text.org}
                </h3>
                <p class="mt-1 text-sm text-ink-soft">{text.role}</p>
              </div>
            </div>
            <div class="md:col-span-5">
              <p class="text-sm leading-relaxed text-muted md:text-base">
                {text.description}
              </p>
              {text.tags && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {text.tags.map((tag) => (
                    <span class="rounded-full border border-line px-3 py-1 text-xs uppercase tracking-wider text-ink-soft">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              <a
                href={`${basePath}/${exp.slug}/`}
                data-magnetic
                class="mt-4 inline-flex items-center gap-2 text-xs uppercase tracking-widest text-ink-soft transition-colors duration-300 hover:text-accent"
              >
                {cases.details}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
