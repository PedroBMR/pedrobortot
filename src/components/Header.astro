---
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  lang?: Locale;
  translatedPath?: string;
}

const { lang = "pt", translatedPath } = Astro.props;
const t = useTranslations(lang);
const nav = t("nav");

const links = [
  { href: "#sobre", label: nav.sobre },
  { href: "#cases", label: nav.cases },
  { href: "#projetos", label: nav.projetos },
  { href: "#skills", label: nav.skills },
  { href: "#contato", label: nav.contato },
];

const otherLang: Locale = lang === "pt" ? "en" : "pt";
const otherPath = translatedPath ?? (lang === "pt" ? "/en/" : "/");
---

<header
  class="fixed top-0 left-0 right-0 z-[60] mix-blend-difference"
  data-header
>
  <div
    class="flex items-center justify-between px-6 md:px-12 py-6 text-ink"
  >
    <a
      href="#hero"
      class="font-display text-sm font-medium tracking-widest uppercase"
      data-reveal-fade
    >
      Pedro Bortot
    </a>
    <nav class="hidden md:flex items-center gap-8 text-sm" data-reveal-fade>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="uppercase tracking-widest text-ink/70 hover:text-ink transition-colors duration-300"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-6" data-reveal-fade>
      <a
        href="mailto:pedroluizbmr@gmail.com"
        class="hidden sm:inline text-sm uppercase tracking-widest text-ink/70 hover:text-ink transition-colors duration-300"
      >
        pedroluizbmr@gmail.com ↗
      </a>
      <a
        href={otherPath}
        class="text-sm uppercase tracking-widest text-ink/70 hover:text-ink transition-colors duration-300"
      >
        {otherLang}
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex flex-col items-end gap-1.5 md:hidden"
      >
        <span class="sr-only">{nav.openMenu}</span>
        <span
          class="h-px w-6 bg-ink transition-transform duration-300"
          data-menu-line="1"
        ></span>
        <span
          class="h-px w-6 bg-ink transition-transform duration-300"
          data-menu-line="2"
        ></span>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  class="invisible fixed inset-0 z-50 flex flex-col items-start justify-center gap-2 bg-void px-6 opacity-0 transition-opacity duration-300 md:hidden"
>
  {
    links.map((link) => (
      <a
        href={link.href}
        data-menu-link
        class="py-2 font-display text-4xl text-ink transition-colors duration-300 hover:text-accent"
      >
        {link.label}
      </a>
    ))
  }
  <a
    href={otherPath}
    data-menu-link
    class="mt-8 text-sm uppercase tracking-widest text-ink/70"
  >
    {otherLang === "en" ? "English" : "Português"}
  </a>
  <a
    href="mailto:pedroluizbmr@gmail.com"
    data-menu-link
    class="mt-4 text-sm uppercase tracking-widest text-ink/70"
  >
    pedroluizbmr@gmail.com ↗
  </a>
</div>

<script>
  import { stopScroll, startScroll } from "../lib/smoothScroll";

  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-menu-toggle]"
  );
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const menuLines = document.querySelectorAll<HTMLElement>("[data-menu-line]");
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>(
    "[data-menu-link]"
  );

  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove("invisible", "opacity-0");
    menu.classList.add("opacity-100");
    toggle.setAttribute("aria-expanded", "true");
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
    stopScroll();
    menuLines[0]?.style.setProperty("transform", "translateY(3.5px) rotate(-45deg)");
    menuLines[1]?.style.setProperty("transform", "translateY(-3.5px) rotate(45deg)");
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.add("opacity-0");
    menu.classList.remove("opacity-100");
    toggle.setAttribute("aria-expanded", "false");
    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
    startScroll();
    menuLines[0]?.style.setProperty("transform", "none");
    menuLines[1]?.style.setProperty("transform", "none");
    window.setTimeout(() => {
      if (toggle.getAttribute("aria-expanded") === "false") {
        menu.classList.add("invisible");
      }
    }, 300);
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
