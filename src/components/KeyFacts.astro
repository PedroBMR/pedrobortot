---
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const keyfacts = t("keyfacts");

const facts = [
  { target: 6, suffix: "+", label: keyfacts.years },
  { target: 4, suffix: "", label: keyfacts.teaching },
  { target: 50, suffix: "+", label: keyfacts.parts },
  { target: 8, suffix: "", label: keyfacts.orgs },
];
---

<section class="border-t border-line px-6 py-20 md:px-12 md:py-28">
  <div class="grid grid-cols-2 gap-x-6 gap-y-14 md:grid-cols-4">
    {
      facts.map((fact) => (
        <div data-reveal>
          <span
            class="font-display text-5xl text-ink md:text-7xl"
            data-counter
            data-target={fact.target}
            data-suffix={fact.suffix}
          >
            0
          </span>
          <p class="mt-3 max-w-[18ch] text-sm text-muted">{fact.label}</p>
        </div>
      ))
    }
  </div>
</section>
