---
import { projects } from "../data/projects";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const projectsUi = t("projects");
---

<section
  id="projetos"
  class="scroll-mt-24 border-t border-line px-6 py-20 md:px-12 md:py-32"
>
  <div class="mb-14 flex items-end justify-between md:mb-20" data-reveal>
    <h2 class="font-display text-4xl text-ink md:text-6xl">{projectsUi.heading}</h2>
    <a
      href="https://github.com/PedroBMR"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden text-sm uppercase tracking-widest text-muted transition-colors duration-300 hover:text-accent md:block"
    >
      {projectsUi.viewGithub}
    </a>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block border border-line transition-colors duration-500 hover:border-accent"
          data-reveal
        >
          <div
            class={`case-bg-${project.variant} flex aspect-video items-center justify-center`}
          >
            <span class="font-display text-6xl font-medium text-ink/25">
              {project.name.charAt(0)}
            </span>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-display text-lg text-ink transition-colors duration-300 group-hover:text-accent">
                {project.name}
              </h3>
              <span class="shrink-0 text-xs uppercase tracking-wider text-muted">
                {project.language}
              </span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {project.description[lang]}
            </p>
          </div>
        </a>
      ))
    }
  </div>

  <a
    href="https://github.com/PedroBMR"
    target="_blank"
    rel="noopener noreferrer"
    class="mt-10 flex items-center gap-2 text-sm uppercase tracking-widest text-muted transition-colors duration-300 hover:text-accent md:hidden"
    data-reveal
  >
    {projectsUi.viewAllGithub}
  </a>
</section>
